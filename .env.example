# ============================================================
# AI 配置（全部可选 —— 一个都不填也能玩，走本地离线模拟器）
# ============================================================

# ---- 全局默认（最简单的接法：只填这一个 key 即可启用真实 AI）----
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.openai.com/v1   # 任意 OpenAI 兼容供应商均可
# OPENAI_MODEL=gpt-4o-mini

# ---- 按模块区分密钥（同一个供应商、不同 key，便于分账单/分限流）----
# 三个模块：CHARACTER=角色对话，DIRECTOR=剧情导演，MEMORY=记忆摘要。
# 未设置的项自动回落到上面的全局值；哪个模块连 key 都没有，就自动用离线模拟器。
# OPENAI_API_KEY_CHARACTER=sk-aaa...
# OPENAI_API_KEY_DIRECTOR=sk-bbb...
# OPENAI_API_KEY_MEMORY=sk-ccc...

# ---- 每个模块也可以单独指定模型 / 接入点（可混用不同供应商）----
# OPENAI_MODEL_CHARACTER=gpt-4o
# OPENAI_MODEL_DIRECTOR=gpt-4o-mini
# OPENAI_MODEL_MEMORY=gpt-4o-mini
# OPENAI_BASE_URL_DIRECTOR=https://openrouter.ai/api/v1

# ============================================================
# 数据库
# ============================================================
# DATABASE_URL=postgres://user:pass@localhost:5432/galgame
